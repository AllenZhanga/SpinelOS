[Desktop Entry]
Name=Spinel Files
Name[zh_CN]=文件管理 (Spinel Files)
Comment=Lightweight native file manager for SpinelOS
Exec=/usr/local/bin/spinel-files %U
Icon=system-file-manager
Terminal=false
Type=Application
Categories=System;FileManager;
MimeType=inode/directory;
StartupWMClass=org.spinelos.files
