// SpinelOS Plymouth Boot Splash Script
Window.SetBackgroundTopColor(0.024, 0.043, 0.086);
Window.SetBackgroundBottomColor(0.043, 0.078, 0.160);

screen_w = Window.GetWidth();
screen_h = Window.GetHeight();

logo.image = Image("logo.png");
logo.sprite = Sprite(logo.image);
logo_x = screen_w / 2 - logo.image.GetWidth() / 2;
logo_y = screen_h * 0.42 - logo.image.GetHeight() / 2;
logo.sprite.SetPosition(logo_x, logo_y, 10);

title.image = Image.Text("SpinelOS", 0.96, 0.98, 1.0, 1.0, "Sans Bold 24");
title.sprite = Sprite(title.image);
title.sprite.SetPosition(screen_w / 2 - title.image.GetWidth() / 2,
                         logo_y + logo.image.GetHeight() + 22, 10);

sub.image = Image.Text("Gaming Linux", 0.58, 0.66, 0.80, 0.9, "Sans 12");
sub.sprite = Sprite(sub.image);
sub.sprite.SetPosition(screen_w / 2 - sub.image.GetWidth() / 2,
                       logo_y + logo.image.GetHeight() + 58, 10);

spinner.base = Image("spinner_ring.png");
spinner_cx = screen_w / 2;
spinner_cy = logo_y + logo.image.GetHeight() + 114;

spinner_frames = 48;
for (i = 0; i < spinner_frames; i++) {
    spinner_imgs[i] = spinner.base.Rotate(2 * 3.14159265 * i / spinner_frames);
}
spinner.sprite = Sprite(spinner_imgs[0]);
spinner.sprite.SetPosition(spinner_cx - spinner_imgs[0].GetWidth() / 2,
                           spinner_cy - spinner_imgs[0].GetHeight() / 2, 11);

status_y = spinner_cy + 34;
status.sprite = Sprite();
status.sprite.SetPosition(screen_w / 2, status_y, 12);

tick = 0;

fun refresh_callback() {
    tick++;
    // Smooth subtle breathing glow on logo during boot
    pulse = 0.90 + 0.10 * Math.Sin(tick * 0.08);
    logo.sprite.SetOpacity(pulse);

    // Smooth continuous ring rotation (re-centered as rotated bounds change)
    idx = tick % spinner_frames;
    frame = spinner_imgs[idx];
    spinner.sprite.SetImage(frame);
    spinner.sprite.SetPosition(spinner_cx - frame.GetWidth() / 2,
                               spinner_cy - frame.GetHeight() / 2, 11);
}
Plymouth.SetRefreshFunction(refresh_callback);

fun message_callback(text) {
    msg_img = Image.Text(text, 0.82, 0.88, 0.96, 1.0, "Sans 11");
    status.sprite.SetImage(msg_img);
    status.sprite.SetPosition(screen_w / 2 - msg_img.GetWidth() / 2, status_y, 12);
}
Plymouth.SetMessageFunction(message_callback);
