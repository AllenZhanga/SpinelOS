# SpinelLight — macOS-inspired light window decoration for labwc
border.width: 1
padding.width: 10
padding.height: 8

window.titlebar.padding.width: 10
window.titlebar.padding.height: 7
window.label.text.justify: center

window.active.title.bg: flat solid
window.active.title.bg.color: #f3f6fb
window.inactive.title.bg: flat solid
window.inactive.title.bg.color: #e9eef6

window.active.label.bg: parentrelative
window.active.label.text.color: #0f172a
window.inactive.label.bg: parentrelative
window.inactive.label.text.color: #64748b

window.active.border.color: #cfd8e3
window.inactive.border.color: #dbe2ec

window.active.button.unpressed.bg: parentrelative
window.active.button.hover.bg: parentrelative
window.inactive.button.unpressed.bg: parentrelative
window.inactive.button.hover.bg: parentrelative

window.button.width: 14
window.button.height: 14
window.button.spacing: 8
window.button.hover.bg.corner-radius: 50

window.active.shadow.size: 32
window.active.shadow.color: #0f172a2e
window.inactive.shadow.size: 18
window.inactive.shadow.color: #0f172a18

osd.bg: flat solid
osd.bg.color: #ffffff
osd.border.color: #0284c7
osd.border.width: 1
osd.label.text.color: #0f172a
