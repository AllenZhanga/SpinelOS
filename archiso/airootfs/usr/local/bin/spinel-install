#!/usr/bin/env bash
set -euo pipefail

MODE="disk"
DISK=""
ROOT_PART=""
EFI_PART=""
FS_TYPE="ext4"
USERNAME="gamer"
HOSTNAME="spinelos"
TIMEZONE="Asia/Shanghai"
AUTOLOGIN="true"
OS_PROBER="false"
INSTALL_ROOT_MOUNTED=false

while [[ $# -gt 0 ]]; do
  case "$1" in
    --mode) MODE="${2:-disk}"; shift 2 ;;
    --disk) DISK="${2:-}"; shift 2 ;;
    --root-part) ROOT_PART="${2:-}"; shift 2 ;;
    --efi-part) EFI_PART="${2:-}"; shift 2 ;;
    --fs) FS_TYPE="${2:-ext4}"; shift 2 ;;
    --username) USERNAME="${2:-}"; shift 2 ;;
    --hostname) HOSTNAME="${2:-}"; shift 2 ;;
    --timezone) TIMEZONE="${2:-}"; shift 2 ;;
    --autologin) AUTOLOGIN="${2:-true}"; shift 2 ;;
    --os-prober) OS_PROBER="${2:-false}"; shift 2 ;;
    *) echo "Unknown argument: $1" >&2; exit 1 ;;
  esac
done

if [[ "$FS_TYPE" != "ext4" && "$FS_TYPE" != "btrfs" ]]; then
  echo "[ERROR] Invalid filesystem type: '$FS_TYPE' (expected ext4 or btrfs)" >&2
  exit 1
fi

if [[ "$(id -u)" -ne 0 ]]; then
  echo "[ERROR] spinel-install must run as root." >&2
  exit 1
fi

if [[ "$MODE" != "disk" && "$MODE" != "partition" ]]; then
  echo "[ERROR] Invalid install mode: '$MODE'" >&2
  exit 1
fi

if [[ "$MODE" == "disk" ]]; then
  if [[ -z "$DISK" || ! -b "$DISK" ]]; then
    echo "[ERROR] Invalid target disk: '$DISK'" >&2
    exit 1
  fi
else
  if [[ -z "$ROOT_PART" || ! -b "$ROOT_PART" ]]; then
    echo "[ERROR] Invalid root partition: '$ROOT_PART'" >&2
    exit 1
  fi
fi

if [[ ! "$USERNAME" =~ ^[a-z_][a-z0-9_-]{0,30}$ ]]; then
  echo "[ERROR] Invalid username: '$USERNAME'" >&2
  exit 1
fi

if [[ ! "$HOSTNAME" =~ ^[a-zA-Z0-9][a-zA-Z0-9-]{0,62}$ ]]; then
  echo "[ERROR] Invalid hostname: '$HOSTNAME'" >&2
  exit 1
fi

if [[ ! -f "/usr/share/zoneinfo/${TIMEZONE}" ]]; then
  echo "[ERROR] Invalid timezone: '$TIMEZONE'" >&2
  exit 1
fi

# Read user/root password securely from stdin
IFS= read -r TARGET_PASSWORD || true
if [[ ${#TARGET_PASSWORD} -lt 4 ]]; then
  echo "[ERROR] Password must be at least 4 characters." >&2
  exit 1
fi

progress() {
  echo "@@PROGRESS:${1}:${2}"
}

cleanup_on_error() {
  local rc=$?
  if [[ $rc -ne 0 ]]; then
    echo "[ERROR] Installation failed (exit code $rc)."
    if [[ "$INSTALL_ROOT_MOUNTED" == "true" ]]; then
      umount -R /mnt 2>/dev/null || true
    fi
  fi
}

# Prevent overwriting active boot medium or current root
BOOTMNT_SRC="$(findmnt -n -o SOURCE /run/archiso/bootmnt 2>/dev/null || true)"
BOOTMNT_DISK=""
if [[ -n "$BOOTMNT_SRC" ]]; then
  PK="$(lsblk -no PKNAME "$BOOTMNT_SRC" 2>/dev/null | head -n1 || true)"
  [[ -n "$PK" ]] && BOOTMNT_DISK="/dev/${PK}"
fi
ACTIVE_ROOT_SRC="$(findmnt -n -o SOURCE / 2>/dev/null || true)"

IS_UEFI=false
if [[ -d /sys/firmware/efi/efivars ]]; then
  IS_UEFI=true
fi

part_path() {
  local disk="$1"
  local idx="$2"
  if [[ "$disk" =~ [0-9]$ ]]; then
    echo "${disk}p${idx}"
  else
    echo "${disk}${idx}"
  fi
}

mount_formatted_root() {
  local dev="$1"
  if [[ "$FS_TYPE" == "btrfs" ]]; then
    if ! command -v mkfs.btrfs >/dev/null 2>&1; then
      echo "[ERROR] mkfs.btrfs not found. Please install btrfs-progs or choose ext4." >&2
      exit 1
    fi
    mkfs.btrfs -f -L SPINEL_ROOT "$dev"
    mount "$dev" /mnt
    INSTALL_ROOT_MOUNTED=true
    btrfs subvolume create /mnt/@
    btrfs subvolume create /mnt/@home
    btrfs subvolume create /mnt/@snapshots
    btrfs subvolume create /mnt/@var_log
    umount /mnt
    INSTALL_ROOT_MOUNTED=false
    mount -o compress=zstd:3,noatime,subvol=@ "$dev" /mnt
    INSTALL_ROOT_MOUNTED=true
    mkdir -p /mnt/{home,.snapshots,var/log}
    mount -o compress=zstd:3,noatime,subvol=@home "$dev" /mnt/home
    mount -o compress=zstd:3,noatime,subvol=@snapshots "$dev" /mnt/.snapshots
    mount -o compress=zstd:3,noatime,subvol=@var_log "$dev" /mnt/var/log
  else
    mkfs.ext4 -F -L SPINEL_ROOT "$dev"
    mount "$dev" /mnt
    INSTALL_ROOT_MOUNTED=true
  fi
}

check_min_bytes() {
  local dev="$1"
  local min_bytes=21474836480 # 20 GiB
  local sz
  sz="$(lsblk -bdno SIZE "$dev" 2>/dev/null | head -n1 || echo 0)"
  if [[ "${sz:-0}" -lt "$min_bytes" ]]; then
    echo "[ERROR] 目标存储空间不足 20 GiB（当前 $((sz / 1073741824)) GiB），无法完整安装 Spinel OS。" >&2
    exit 1
  fi
}

check_disk_idle() {
  local disk="$1" mounts="$2" devices type dev_id mountpoints
  if ! devices="$(lsblk --raw --noheadings --output TYPE,MAJ:MIN,MOUNTPOINTS -- "$disk")"; then
    echo "[ERROR] 无法核验目标磁盘（$disk）。" >&2
    return 1
  fi

  read -r type dev_id mountpoints <<< "$devices"
  if [[ "$type" != "disk" || ! "$dev_id" =~ ^[0-9]+:[0-9]+$ ]]; then
    echo "[ERROR] 整盘安装需要选择整块磁盘（$disk）。" >&2
    return 1
  fi

  # Match the kernel mount table by device number, regardless of the source path.
  # lsblk also reports Btrfs source mountpoints and active swap as [SWAP].
  local -A mounted_at=()
  while read -r dev_id mountpoints; do
    mounted_at["$dev_id"]="$mountpoints"
  done <<< "$mounts"
  while read -r type dev_id mountpoints; do
    if [[ ! "$dev_id" =~ ^[0-9]+:[0-9]+$ ]]; then
      echo "[ERROR] 无法核验目标磁盘的分区或映射设备（$disk）。" >&2
      return 1
    fi
    local in_use="${mounted_at[$dev_id]:-$mountpoints}"
    if [[ -n "$in_use" ]]; then
      echo "[ERROR] 目标磁盘或其关联设备正在使用（$disk，设备 $dev_id：$in_use）。请卸载目标分区并停用交换空间后重试。" >&2
      return 1
    fi
  done <<< "$devices"
}

if [[ "$MODE" == "disk" ]]; then
  # Use the canonical device name for checks and subsequent partition paths.
  if ! canonical_disk="$(readlink -e -- "$DISK")"; then
    echo "[ERROR] 无法解析目标磁盘的设备路径（$DISK）。" >&2
    exit 1
  fi
  DISK="$canonical_disk"
  if [[ -n "$BOOTMNT_SRC" && ( "$DISK" == "$BOOTMNT_SRC" || "$DISK" == "$BOOTMNT_DISK" ) ]]; then
    echo "[ERROR] Refusing to overwrite the active Live ISO boot device ($DISK)." >&2
    exit 1
  fi
  check_min_bytes "$DISK"
fi

if ! install_mounts="$(findmnt --kernel --raw --noheadings --output MAJ:MIN,TARGET)" ||
   [[ -z "$install_mounts" ]]; then
  echo "[ERROR] 无法核验系统挂载状态。" >&2
  exit 1
fi
while read -r _ mountpoint; do
  if [[ "$mountpoint" == "/mnt" || "$mountpoint" == /mnt/* ]]; then
    echo "[ERROR] 安装需要使用 /mnt，现有挂载点 $mountpoint 正在占用该目录。请手动卸载后重试。" >&2
    exit 1
  fi
done <<< "$install_mounts"

if [[ "$MODE" == "disk" ]]; then
  check_disk_idle "$DISK" "$install_mounts"
fi
trap cleanup_on_error EXIT

if [[ "$MODE" == "disk" ]]; then
  echo "==> Mode: Full Disk Wipe -> $DISK (UEFI=$IS_UEFI, FS=$FS_TYPE)"
  progress 8 "正在清理旧分区并创建分区表 (${FS_TYPE})..."
  wipefs -af -- "$DISK"

  if [[ "$IS_UEFI" == "true" ]]; then
    parted -s "$DISK" mklabel gpt \
      mkpart ESP fat32 1MiB 513MiB \
      set 1 esp on \
      mkpart SPINEL_ROOT "$FS_TYPE" 513MiB 100%
  else
    parted -s "$DISK" mklabel gpt \
      mkpart BIOSBOOT 1MiB 3MiB \
      set 1 bios_grub on \
      mkpart SPINEL_ROOT "$FS_TYPE" 3MiB 100%
  fi

  partprobe "$DISK" || true
  udevadm settle || sleep 2

  PART_1="$(part_path "$DISK" 1)"
  PART_2="$(part_path "$DISK" 2)"

  if [[ "$IS_UEFI" == "true" ]]; then
    echo "==> Formatting EFI ($PART_1) and Root ($PART_2, $FS_TYPE)..."
    mkfs.fat -F32 -n SPINEL_EFI "$PART_1"
    mount_formatted_root "$PART_2"
    mkdir -p /mnt/boot/efi
    mount "$PART_1" /mnt/boot/efi
  else
    echo "==> Formatting Root ($PART_2, $FS_TYPE) for Legacy BIOS boot..."
    mount_formatted_root "$PART_2"
  fi
  TARGET_LABEL="$DISK"
else
  ROOT_PARENT_PK="$(lsblk -no PKNAME "$ROOT_PART" 2>/dev/null | head -n1 || true)"
  ROOT_PARENT_DISK=""
  [[ -n "$ROOT_PARENT_PK" ]] && ROOT_PARENT_DISK="/dev/${ROOT_PARENT_PK}"

  if [[ "$ROOT_PART" == "$BOOTMNT_SRC" || "$ROOT_PART" == "$ACTIVE_ROOT_SRC" || ( -n "$BOOTMNT_DISK" && "$ROOT_PARENT_DISK" == "$BOOTMNT_DISK" ) ]]; then
    echo "[ERROR] Refusing to install onto active boot/root device ($ROOT_PART)." >&2
    exit 1
  fi
  check_min_bytes "$ROOT_PART"

  if [[ "$IS_UEFI" == "true" ]]; then
    if [[ -z "$EFI_PART" || ! -b "$EFI_PART" ]]; then
      echo "[ERROR] UEFI mode requires a valid existing EFI partition." >&2
      exit 1
    fi
    EFI_FS="$(blkid -o value -s TYPE "$EFI_PART" 2>/dev/null || true)"
    if [[ "$EFI_FS" != "vfat" ]]; then
      echo "[ERROR] EFI partition ($EFI_PART) must be FAT32/vfat (detected: '$EFI_FS')." >&2
      exit 1
    fi
    if [[ "$EFI_PART" == "$ROOT_PART" ]]; then
      echo "[ERROR] Root partition and EFI partition cannot be the same." >&2
      exit 1
    fi
  fi

  echo "==> Mode: Custom Partition -> Root=$ROOT_PART ($FS_TYPE) EFI=${EFI_PART:-none} (UEFI=$IS_UEFI, os-prober=$OS_PROBER)"
  progress 8 "正在格式化目标根分区 ${ROOT_PART} (${FS_TYPE})..."
  swapoff "$ROOT_PART" 2>/dev/null || true
  umount -f "$ROOT_PART" 2>/dev/null || true
  mount_formatted_root "$ROOT_PART"

  if [[ "$IS_UEFI" == "true" ]]; then
    echo "==> Mounting existing EFI partition $EFI_PART without formatting..."
    umount -f "$EFI_PART" 2>/dev/null || true
    mkdir -p /mnt/boot/efi
    mount "$EFI_PART" /mnt/boot/efi
  fi
  DISK="$ROOT_PARENT_DISK"
  TARGET_LABEL="$ROOT_PART"
fi

echo "==> User: $USERNAME | Hostname: $HOSTNAME | Timezone: $TIMEZONE | Autologin: $AUTOLOGIN"

progress 22 "正在复制 Spinel OS 系统镜像到目标分区（可能需要几分钟）..."
SFS_PATH="/run/archiso/bootmnt/arch/x86_64/airootfs.sfs"
if [[ -f "$SFS_PATH" ]]; then
  echo "==> Extracting $SFS_PATH to /mnt..."
  unsquashfs -f -d /mnt "$SFS_PATH"
  # Carry over any hot-updated desktop shell / launcher / UI from Live session overlay
  [[ -x /usr/local/bin/spinel-shell ]] && cp -f /usr/local/bin/spinel-shell /mnt/usr/local/bin/spinel-shell
  [[ -x /usr/local/bin/spinel-webui ]] && cp -f /usr/local/bin/spinel-webui /mnt/usr/local/bin/spinel-webui
  [[ -x /usr/local/bin/spinel-terminal ]] && cp -f /usr/local/bin/spinel-terminal /mnt/usr/local/bin/spinel-terminal
  [[ -x /usr/local/bin/spinel-files ]] && cp -f /usr/local/bin/spinel-files /mnt/usr/local/bin/spinel-files
  [[ -x /usr/local/bin/start-spinel-desktop ]] && cp -f /usr/local/bin/start-spinel-desktop /mnt/usr/local/bin/start-spinel-desktop
  [[ -x /usr/local/bin/spinel-screenshot ]] && cp -f /usr/local/bin/spinel-screenshot /mnt/usr/local/bin/spinel-screenshot
  [[ -x /usr/local/bin/spinel-lock ]] && cp -f /usr/local/bin/spinel-lock /mnt/usr/local/bin/spinel-lock
  if [[ -d /usr/share/spinel-shell/ui ]]; then
    mkdir -p /mnt/usr/share/spinel-shell/ui
    cp -a /usr/share/spinel-shell/ui/. /mnt/usr/share/spinel-shell/ui/
  fi
elif [[ -d /run/archiso/airootfs ]]; then
  echo "==> Syncing /run/archiso/airootfs to /mnt..."
  rsync -aAXH /run/archiso/airootfs/ /mnt/
else
  echo "==> Syncing live root filesystem to /mnt..."
  rsync -aAXH \
    --exclude={"/dev/*","/proc/*","/sys/*","/tmp/*","/run/*","/mnt/*","/media/*","/lost+found"} \
    / /mnt/
fi

mkdir -p /mnt/{dev,proc,sys,tmp,run,mnt}
chmod 1777 /mnt/tmp

progress 55 "正在生成 fstab 并清理 Live ISO 临时配置..."
genfstab -U /mnt > /mnt/etc/fstab

rm -f /mnt/etc/mkinitcpio.conf.d/archiso.conf
rm -f /mnt/etc/systemd/system/multi-user.target.wants/pacman-init.service
rm -f /mnt/etc/systemd/system/multi-user.target.wants/choose-mirror.service
rm -f /mnt/etc/systemd/system/multi-user.target.wants/livecd-alsa-unmuter.service
rm -f /mnt/etc/systemd/system/multi-user.target.wants/systemd-networkd-wait-online.service
rm -f /mnt/etc/systemd/system/multi-user.target.wants/systemd-networkd.service
rm -f /mnt/etc/systemd/system/sockets.target.wants/systemd-networkd.socket
rm -f /mnt/etc/systemd/system/multi-user.target.wants/iwd.service
rm -f /mnt/etc/systemd/network/*.network /mnt/etc/systemd/network/*.link 2>/dev/null || true
rm -f /mnt/etc/systemd/system/etc-pacman.d-gnupg.mount
rm -f /mnt/etc/systemd/system/getty@tty1.service.d/autologin.conf
rm -f /mnt/etc/sysusers.d/gamer.conf
rm -f /mnt/etc/tmpfiles.d/gamer.conf
rm -f /mnt/etc/sudoers.d/gamer

if [[ ! -f /mnt/boot/vmlinuz-linux ]]; then
  KVER="$(ls /mnt/usr/lib/modules 2>/dev/null | head -n1 || true)"
  if [[ -n "$KVER" && -f "/mnt/usr/lib/modules/${KVER}/vmlinuz" ]]; then
    cp "/mnt/usr/lib/modules/${KVER}/vmlinuz" /mnt/boot/vmlinuz-linux
  else
    echo "[ERROR] Cannot find Linux kernel image in /mnt." >&2
    exit 1
  fi
fi

# Apply SpinelOS identity on installed system
echo "$HOSTNAME" > /mnt/etc/hostname
cat > /mnt/etc/hosts <<EOF
127.0.0.1   localhost
::1         localhost
127.0.1.1   ${HOSTNAME}.localdomain ${HOSTNAME}
EOF

rm -f /mnt/etc/os-release
cat > /mnt/etc/os-release <<'EOF'
NAME="Spinel OS"
PRETTY_NAME="Spinel OS"
ID=spinelos
ID_LIKE=arch
BUILD_ID=rolling
ANSI_COLOR="38;2;56;189;248"
HOME_URL="https://github.com/AllenZhanga/SpinelOS"
LOGO=spinelos
EOF

cat > /mnt/etc/motd <<'EOF'
Spinel OS — Wayland Desktop
EOF

sed -i 's/^#\s*en_US.UTF-8 UTF-8/en_US.UTF-8 UTF-8/' /mnt/etc/locale.gen
sed -i 's/^#\s*zh_CN.UTF-8 UTF-8/zh_CN.UTF-8 UTF-8/' /mnt/etc/locale.gen
echo "LANG=zh_CN.UTF-8" > /mnt/etc/locale.conf
if [[ ! -f /mnt/etc/vconsole.conf ]]; then
  echo "KEYMAP=us" > /mnt/etc/vconsole.conf
fi

progress 70 "正在配置用户账号、密码、时区与桌面自启..."
arch-chroot /mnt /bin/bash -euo pipefail <<EOF
ln -sf "/usr/share/zoneinfo/${TIMEZONE}" /etc/localtime
hwclock --systohc 2>/dev/null || true
locale-gen

if id -u "${USERNAME}" >/dev/null 2>&1; then
  usermod -aG wheel,video,audio,input,render "${USERNAME}"
else
  useradd -m -G wheel,video,audio,input,render -s /bin/bash "${USERNAME}"
fi
systemctl enable cups.service >/dev/null 2>&1 || true
EOF

printf "root:%s\n%s:%s\n" "$TARGET_PASSWORD" "$USERNAME" "$TARGET_PASSWORD" | arch-chroot /mnt chpasswd

mkdir -p /mnt/etc/sudoers.d
cat > /mnt/etc/sudoers.d/wheel <<'EOF'
%wheel ALL=(ALL:ALL) ALL
EOF
chmod 0440 /mnt/etc/sudoers.d/wheel

cat > /mnt/etc/profile.d/spinel-autostart.sh <<EOF
# Auto-launch SpinelOS Wayland desktop on tty1 for ${USERNAME}
if [ -z "\${DISPLAY:-}" ] && [ -z "\${WAYLAND_DISPLAY:-}" ] && [ "\$(tty 2>/dev/null)" = "/dev/tty1" ] && [ "\$(id -un)" = "${USERNAME}" ]; then
  exec /usr/local/bin/start-spinel-desktop
fi
EOF

if [[ "$AUTOLOGIN" == "true" ]]; then
  mkdir -p /mnt/etc/systemd/system/getty@tty1.service.d
  cat > /mnt/etc/systemd/system/getty@tty1.service.d/autologin.conf <<EOF
[Service]
ExecStart=
ExecStart=-/sbin/agetty -o '-p -f -- \\u' --noclear --autologin ${USERNAME} %I \$TERM
EOF
fi

if [[ -f /etc/pacman.d/gnupg/pubring.gpg ]]; then
  rm -rf /mnt/etc/pacman.d/gnupg
  cp -a /etc/pacman.d/gnupg /mnt/etc/pacman.d/gnupg
else
  arch-chroot /mnt bash -c "pacman-key --init && pacman-key --populate archlinux" || true
fi

# Enable [multilib] (Steam / 32-bit Vulkan & Proton libs) and parallel downloads
if [[ -f /mnt/etc/pacman.conf ]]; then
  sed -i 's/^#*\s*ParallelDownloads\s*=.*/ParallelDownloads = 8/' /mnt/etc/pacman.conf
  if ! grep -q '^ParallelDownloads' /mnt/etc/pacman.conf; then
    sed -i '/^\[options\]/a ParallelDownloads = 8' /mnt/etc/pacman.conf
  fi
  if ! grep -q '^\[multilib\]' /mnt/etc/pacman.conf; then
    if grep -q '^#\[multilib\]' /mnt/etc/pacman.conf; then
      sed -i '/^#\[multilib\]/{s/^#//;n;s/^#//}' /mnt/etc/pacman.conf
    else
      printf '\n[multilib]\nInclude = /etc/pacman.d/mirrorlist\n' >> /mnt/etc/pacman.conf
    fi
  fi
fi

progress 82 "正在重建标准硬盘 initramfs 与快照配置..."
if [[ "$FS_TYPE" == "btrfs" ]] && [[ -x /mnt/usr/bin/snapper ]]; then
  arch-chroot /mnt bash -c 'umount /.snapshots 2>/dev/null || true; rm -rf /.snapshots; snapper --no-dbus -c root create-config / 2>/dev/null || true; btrfs subvolume delete /.snapshots 2>/dev/null || rm -rf /.snapshots; mkdir -p /.snapshots; mount -a 2>/dev/null || true'
fi
if [[ -f /mnt/etc/mkinitcpio.conf ]] && [[ -x /mnt/usr/bin/plymouthd ]]; then
  if ! grep -q '\bplymouth\b' /mnt/etc/mkinitcpio.conf; then
    sed -i 's/\budev\b/udev plymouth/' /mnt/etc/mkinitcpio.conf
  fi
fi
arch-chroot /mnt mkinitcpio -P

progress 92 "正在安装 GRUB 引导程序并写入 Spinel OS 引导项..."
if [[ -d /usr/share/grub/themes/spinelos ]]; then
  mkdir -p /mnt/boot/grub/themes/spinelos
  cp -a /usr/share/grub/themes/spinelos/. /mnt/boot/grub/themes/spinelos/
fi
if [[ -f /mnt/etc/default/grub ]]; then
  set_grub_kv() {
    local k="$1" v="$2"
    sed -i "/^#*\s*${k}=/d" /mnt/etc/default/grub
    echo "${k}=${v}" >> /mnt/etc/default/grub
  }
  set_grub_kv GRUB_DISTRIBUTOR '"SpinelOS"'
  set_grub_kv GRUB_CMDLINE_LINUX_DEFAULT '"loglevel=3 quiet splash vt.global_cursor_default=0 nvidia_drm.modeset=1 nvidia_drm.fbdev=1"'
  set_grub_kv GRUB_GFXMODE 'auto'
  set_grub_kv GRUB_GFXPAYLOAD_LINUX 'keep'
  set_grub_kv GRUB_THEME '"/boot/grub/themes/spinelos/theme.txt"'
  set_grub_kv GRUB_DISABLE_RECOVERY 'false'
  if [[ "$OS_PROBER" == "true" ]]; then
    set_grub_kv GRUB_TIMEOUT_STYLE 'menu'
    set_grub_kv GRUB_TIMEOUT '3'
    set_grub_kv GRUB_DISABLE_OS_PROBER 'false'
  else
    set_grub_kv GRUB_TIMEOUT_STYLE 'hidden'
    set_grub_kv GRUB_TIMEOUT '2'
  fi
fi

if [[ "$IS_UEFI" == "true" ]]; then
  arch-chroot /mnt grub-install --target=x86_64-efi --efi-directory=/boot/efi --bootloader-id=SpinelOS --recheck || true
  arch-chroot /mnt grub-install --target=x86_64-efi --efi-directory=/boot/efi --removable --recheck
else
  if [[ -z "$DISK" || ! -b "$DISK" ]]; then
    echo "[ERROR] Cannot resolve parent disk for BIOS GRUB install." >&2
    exit 1
  fi
  arch-chroot /mnt grub-install --target=i386-pc --recheck "$DISK"
fi

arch-chroot /mnt grub-mkconfig -o /boot/grub/grub.cfg

sync
umount -R /mnt || true

progress 100 "Spinel OS 已成功安装到 ${TARGET_LABEL}！请拔出安装介质并重启电脑。"
