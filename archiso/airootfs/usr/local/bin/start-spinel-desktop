#!/usr/bin/env bash
set -euo pipefail

export XDG_SESSION_TYPE=wayland
export XDG_CURRENT_DESKTOP=SpinelOS:GNOME
export GDK_BACKEND=wayland
export GTK_THEME=Adwaita
export QT_QPA_PLATFORM=wayland
export SDL_VIDEODRIVER=wayland,x11
export MOZ_ENABLE_WAYLAND=1
export XMODIFIERS=@im=fcitx
export QT_IM_MODULE=fcitx
export SDL_IM_MODULE=fcitx

# Ensure runtime dir & session D-Bus exist (even if logind opened tty1 as user-light or dbus.socket is still starting)
if [ -z "${XDG_RUNTIME_DIR:-}" ]; then
  export XDG_RUNTIME_DIR="/run/user/$(id -u)"
fi
mkdir -p "${XDG_RUNTIME_DIR}"
chmod 700 "${XDG_RUNTIME_DIR}" 2>/dev/null || true
if [ ! -S "${XDG_RUNTIME_DIR}/bus" ] && command -v systemctl >/dev/null 2>&1; then
  systemctl --user start dbus.socket 2>/dev/null || true
  i=0
  while [ ! -S "${XDG_RUNTIME_DIR}/bus" ] && [ "${i}" -lt 20 ]; do
    sleep 0.1
    i=$((i + 1))
  done
fi
if [ -z "${DBUS_SESSION_BUS_ADDRESS:-}" ] && [ -S "${XDG_RUNTIME_DIR}/bus" ]; then
  export DBUS_SESSION_BUS_ADDRESS="unix:path=${XDG_RUNTIME_DIR}/bus"
fi

IS_VM=0
if command -v systemd-detect-virt >/dev/null 2>&1 && systemd-detect-virt -q; then
  IS_VM=1
fi

SAFE_GFX=0
if grep -qw "nomodeset" /proc/cmdline 2>/dev/null || ! ls /dev/dri/renderD* >/dev/null 2>&1; then
  SAFE_GFX=1
fi

# Work around WebKitGTK DMABUF & VM hardware cursor issues on NVIDIA or virtualized GPUs
if [ "${SAFE_GFX}" -eq 1 ]; then
  export WLR_RENDERER=pixman
  export WLR_NO_HARDWARE_CURSORS=1
  export GSK_RENDERER=cairo
  export WEBKIT_DISABLE_DMABUF_RENDERER=1
  export WEBKIT_DISABLE_COMPOSITING_MODE=1
  export LIBGL_ALWAYS_SOFTWARE=1
elif [ -d /sys/module/nvidia ]; then
  export WEBKIT_DISABLE_DMABUF_RENDERER=1
  export GBM_BACKEND=nvidia-drm
  export __GLX_VENDOR_LIBRARY_NAME=nvidia
  export PROTON_ENABLE_NVAPI="${PROTON_ENABLE_NVAPI:-1}"
  export VKD3D_CONFIG="${VKD3D_CONFIG:-dxr,dxr11}"
elif [ "${IS_VM}" -eq 1 ]; then
  export WEBKIT_DISABLE_DMABUF_RENDERER=1
  export WLR_NO_HARDWARE_CURSORS=1
fi

# Force software Pixman/Mesa fallback automatically on VMs without 3D DRM (Hyper-V, basic VBox/VMware, simpledrm)
if [ "${IS_VM}" -eq 1 ]; then
  DRM_DRIVER="$(basename "$(readlink -f /sys/class/drm/card0/device/driver 2>/dev/null || true)" 2>/dev/null || true)"
  case "${DRM_DRIVER}" in
    hyperv_drm|bochs-drm|cirrus|simple-framebuffer|ast)
      export WLR_RENDERER=pixman
      export GSK_RENDERER=cairo
      export WEBKIT_DISABLE_COMPOSITING_MODE=1
      export LIBGL_ALWAYS_SOFTWARE=1
      ;;
  esac
fi

# Propagate desktop env (including DBUS_SESSION_BUS_ADDRESS & XDG_CURRENT_DESKTOP) to systemd user services
if command -v systemctl >/dev/null 2>&1; then
  systemctl --user import-environment DBUS_SESSION_BUS_ADDRESS XDG_CURRENT_DESKTOP XDG_SESSION_TYPE 2>/dev/null || true
  systemctl --user start pipewire.socket pipewire-pulse.socket wireplumber.service 2>/dev/null || true
fi
if [ -n "${DBUS_SESSION_BUS_ADDRESS:-}" ] && command -v dbus-update-activation-environment >/dev/null 2>&1; then
  dbus-update-activation-environment --systemd DBUS_SESSION_BUS_ADDRESS XDG_CURRENT_DESKTOP XDG_SESSION_TYPE 2>/dev/null || true
fi

# Bridge host <-> VM clipboard when running under SPICE/UTM/QEMU
if [ -e /dev/virtio-ports/com.redhat.spice.0 ] && command -v spice-vdagent >/dev/null 2>&1; then
  spice-vdagent >/dev/null 2>&1 || true
fi

run_labwc() {
  if [ -z "${DBUS_SESSION_BUS_ADDRESS:-}" ] && command -v dbus-run-session >/dev/null 2>&1; then
    dbus-run-session -- labwc "$@"
  else
    labwc "$@"
  fi
}

LOG_FILE="/tmp/spinel-labwc.log"
START_TS="$(date +%s)"
set +e
run_labwc >"${LOG_FILE}" 2>&1
RC=$?
END_TS="$(date +%s)"
set -e

# If hardware GLES2 renderer failed immediately (common on VMs without 3D acceleration), retry with pixman
if [ "${RC}" -ne 0 ] && [ $((END_TS - START_TS)) -lt 5 ] && [ "${WLR_RENDERER:-}" != "pixman" ]; then
  echo "[SpinelOS] Hardware renderer failed (rc=${RC}), retrying with software Pixman..." >>"${LOG_FILE}"
  export WLR_RENDERER=pixman
  export WLR_NO_HARDWARE_CURSORS=1
  export GSK_RENDERER=cairo
  export WEBKIT_DISABLE_COMPOSITING_MODE=1
  export LIBGL_ALWAYS_SOFTWARE=1
  set +e
  run_labwc >>"${LOG_FILE}" 2>&1
  RC=$?
  set -e
fi

if [ "${RC}" -ne 0 ]; then
  echo "[SpinelOS] Desktop compositor exited with code ${RC}. Log (${LOG_FILE}):"
  tail -n 25 "${LOG_FILE}" 2>/dev/null || true
  exec /bin/bash -l
fi
