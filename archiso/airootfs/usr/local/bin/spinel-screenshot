#!/usr/bin/env bash
set -euo pipefail

MODE="${1:-area}"
ANNOTATE=0
for arg in "$@"; do
  case "${arg}" in
    --annotate|-e) ANNOTATE=1 ;;
  esac
done

OUT_DIR="${HOME}/Pictures/Screenshots"
mkdir -p "${OUT_DIR}"
OUT_FILE="${OUT_DIR}/SpinelOS_$(date +%Y-%m-%d_%H-%M-%S).png"

notify_shot() {
  local title="$1"
  local body="$2"
  if command -v notify-send >/dev/null 2>&1; then
    notify-send -a "SpinelOS 截图" -t 4000 "${title}" "${body}" 2>/dev/null || true
  elif command -v gdbus >/dev/null 2>&1; then
    gdbus call --session \
      --dest org.freedesktop.Notifications \
      --object-path /org/freedesktop/Notifications \
      --method org.freedesktop.Notifications.Notify \
      "SpinelOS 截图" 0 "camera-photo" "${title}" "${body}" '[]' '{}' 4000 >/dev/null 2>&1 || true
  fi
}

if ! command -v grim >/dev/null 2>&1; then
  notify_shot "截图组件未安装" "请先安装 grim 与 slurp。"
  exit 1
fi

if [[ "${MODE}" == "area" ]] && command -v slurp >/dev/null 2>&1; then
  GEOM="$(slurp -b '#0f172a55' -c '#38bdf8' -w 2 2>/dev/null || true)"
  if [[ -z "${GEOM}" ]]; then
    exit 0
  fi
  grim -g "${GEOM}" "${OUT_FILE}"
else
  grim "${OUT_FILE}"
fi

if [[ "${ANNOTATE}" -eq 1 ]]; then
  if command -v satty >/dev/null 2>&1; then
    satty -f "${OUT_FILE}" --output-filename "${OUT_FILE}" 2>/dev/null || true
  elif command -v swappy >/dev/null 2>&1; then
    swappy -f "${OUT_FILE}" -o "${OUT_FILE}" 2>/dev/null || true
  fi
fi

CLIP_NOTE=""
if command -v wl-copy >/dev/null 2>&1 && [[ -s "${OUT_FILE}" ]]; then
  if wl-copy --type image/png < "${OUT_FILE}" 2>/dev/null; then
    CLIP_NOTE="并复制到剪贴板"
  fi
fi

notify_shot "截图已保存${CLIP_NOTE}" "$(basename "${OUT_FILE}") → ${OUT_DIR}"
