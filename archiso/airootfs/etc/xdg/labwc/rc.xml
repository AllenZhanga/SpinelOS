<?xml version="1.0"?>
<labwc_config>
  <core>
    <gap>0</gap>
    <adaptiveSync>yes</adaptiveSync>
    <reuseOutputMode>yes</reuseOutputMode>
  </core>

  <theme>
    <name>SpinelDark</name>
    <cornerRadius>10</cornerRadius>
    <dropShadows>yes</dropShadows>
  </theme>

  <keyboard>
    <default />
    <keybind key="W-Return">
      <action name="Execute" command="foot" />
    </keybind>
    <keybind key="A-Tab">
      <action name="NextWindow" />
    </keybind>
    <keybind key="A-F4">
      <action name="Close" />
    </keybind>
  </keyboard>

  <mouse>
    <default />
  </mouse>
</labwc_config>
