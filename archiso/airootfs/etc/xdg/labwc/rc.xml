<?xml version="1.0"?>
<labwc_config>
  <core>
    <gap>0</gap>
    <adaptiveSync>yes</adaptiveSync>
    <reuseOutputMode>yes</reuseOutputMode>
  </core>

  <theme>
    <name>SpinelLight</name>
    <cornerRadius>12</cornerRadius>
    <dropShadows>yes</dropShadows>
    <titlebar>
      <layout>close,iconify,max:</layout>
    </titlebar>
  </theme>

  <desktops number="4">
    <popupTime>450</popupTime>
    <prefix>工作区</prefix>
  </desktops>

  <snapping>
    <range inner="10" outer="10" />
    <topMaximize>yes</topMaximize>
  </snapping>

  <keyboard>
    <default />
    <keybind key="W-Return">
      <action name="Execute" command="spinel-terminal" />
    </keybind>
    <keybind key="Print">
      <action name="Execute" command="spinel-screenshot full" />
    </keybind>
    <keybind key="S-Print">
      <action name="Execute" command="spinel-screenshot area" />
    </keybind>
    <keybind key="C-S-4">
      <action name="Execute" command="spinel-screenshot area" />
    </keybind>
    <keybind key="W-l">
      <action name="Execute" command="spinel-lock" />
    </keybind>
    <keybind key="A-space">
      <action name="Execute" command="spinel-shell --launcher" />
    </keybind>
    <keybind key="XF86AudioRaiseVolume">
      <action name="Execute" command="spinel-shell --osd volume-up" />
    </keybind>
    <keybind key="XF86AudioLowerVolume">
      <action name="Execute" command="spinel-shell --osd volume-down" />
    </keybind>
    <keybind key="XF86AudioMute">
      <action name="Execute" command="spinel-shell --osd mute" />
    </keybind>
    <keybind key="XF86MonBrightnessUp">
      <action name="Execute" command="spinel-shell --osd bright-up" />
    </keybind>
    <keybind key="XF86MonBrightnessDown">
      <action name="Execute" command="spinel-shell --osd bright-down" />
    </keybind>
    <keybind key="A-Tab">
      <action name="Execute" command="spinel-shell --switcher next" />
    </keybind>
    <keybind key="A-S-Tab">
      <action name="Execute" command="spinel-shell --switcher prev" />
    </keybind>
    <keybind key="A-F4">
      <action name="Close" />
    </keybind>
    <keybind key="W-Left">
      <action name="SnapToEdge" direction="left" />
    </keybind>
    <keybind key="W-Right">
      <action name="SnapToEdge" direction="right" />
    </keybind>
    <keybind key="W-Up">
      <action name="ToggleMaximize" />
    </keybind>
    <keybind key="W-Down">
      <action name="Iconify" />
    </keybind>
    <keybind key="C-A-Left">
      <action name="GoToDesktop" to="left" wrap="yes" />
    </keybind>
    <keybind key="C-A-Right">
      <action name="GoToDesktop" to="right" wrap="yes" />
    </keybind>
    <keybind key="W-S-Left">
      <action name="SendToDesktop" to="left" wrap="yes" follow="yes" />
    </keybind>
    <keybind key="W-S-Right">
      <action name="SendToDesktop" to="right" wrap="yes" follow="yes" />
    </keybind>
    <keybind key="W-1">
      <action name="GoToDesktop" to="1" />
    </keybind>
    <keybind key="W-2">
      <action name="GoToDesktop" to="2" />
    </keybind>
    <keybind key="W-3">
      <action name="GoToDesktop" to="3" />
    </keybind>
    <keybind key="W-4">
      <action name="GoToDesktop" to="4" />
    </keybind>
    <keybind key="W-S-1">
      <action name="SendToDesktop" to="1" follow="yes" />
    </keybind>
    <keybind key="W-S-2">
      <action name="SendToDesktop" to="2" follow="yes" />
    </keybind>
    <keybind key="W-S-3">
      <action name="SendToDesktop" to="3" follow="yes" />
    </keybind>
    <keybind key="W-S-4">
      <action name="SendToDesktop" to="4" follow="yes" />
    </keybind>
  </keyboard>

  <mouse>
    <default />
  </mouse>

  <windowRules>
    <windowRule title="Spinel 平行沙箱" serverDecoration="no" skipTaskbar="yes" skipWindowSwitcher="yes" matchOnce="true">
      <action name="ToggleAlwaysOnTop" />
      <action name="ToggleOmnipresent" />
    </windowRule>
    <windowRule title="Spinel 平行沙箱" serverDecoration="no" skipTaskbar="yes" skipWindowSwitcher="yes" />
  </windowRules>
</labwc_config>
