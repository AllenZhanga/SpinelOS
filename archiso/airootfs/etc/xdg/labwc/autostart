# Apply saved Wayland display mode if configured
if [ -x "$HOME/.config/spinelos/display.sh" ]; then
  "$HOME/.config/spinelos/display.sh" &
fi

# Export Wayland environment for systemd user services & Portals, then reload portal gateway
if command -v dbus-update-activation-environment >/dev/null 2>&1; then
  dbus-update-activation-environment --systemd DISPLAY WAYLAND_DISPLAY XDG_CURRENT_DESKTOP GTK_THEME XMODIFIERS QT_IM_MODULE SDL_IM_MODULE 2>/dev/null || true
fi
if command -v systemctl >/dev/null 2>&1; then
  systemctl --user restart xdg-desktop-portal xdg-desktop-portal-gtk xdg-desktop-portal-wlr >/dev/null 2>&1 || true
fi

# Start Polkit graphical authentication agent for privilege / admin elevation prompts
if [ -x /usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1 ]; then
  /usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1 >/tmp/spinel-polkit.log 2>&1 &
fi

# Start Wayland notification daemon (mako)
if command -v mako >/dev/null 2>&1; then
  mako >/tmp/spinel-mako.log 2>&1 &
fi

# Persist Wayland clipboard contents across closed source windows
if command -v wl-clip-persist >/dev/null 2>&1; then
  wl-clip-persist --clipboard regular >/tmp/spinel-clip.log 2>&1 &
fi

# Start idle lock daemon when swayidle is enabled (default 15m lock unless disabled in power.conf)
if command -v swayidle >/dev/null 2>&1 && ! grep -qx "idle_lock=false" "$HOME/.config/spinelos/power.conf" 2>/dev/null; then
  swayidle -w timeout 900 'spinel-lock' before-sleep 'spinel-lock' >/tmp/spinel-idle.log 2>&1 &
fi

# Start our custom C++20 + GTK4/WebKitGTK6 Wayland Desktop Shell (with persistent startup log)
/usr/local/bin/spinel-shell >/tmp/spinel-shell.log 2>&1 &

# Start Fcitx5 Wayland input method daemon after spinel-shell initializes profile defaults
if command -v fcitx5 >/dev/null 2>&1; then
  (sleep 0.8; exec fcitx5 -d >/tmp/spinel-fcitx5.log 2>&1) &
fi
