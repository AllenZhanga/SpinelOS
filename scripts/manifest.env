# Shared SpinelOS build, hot-deploy, OTA & validation manifest.
# Sourced by scripts/dev-deploy.sh, scripts/release-ota.sh, and scripts/check.sh.

SPINEL_NATIVE_BINS=(
  spinel-shell
  spinel-webui
  spinel-terminal
  spinel-files
  spinel-sandbox
  spinel-agent-ctl
  spinel-os-mcp
)

SPINEL_HELPER_BINS=(
  spinel-wine
  spinel-update
)

SPINEL_DESKTOP_FILES=(
  org.spinelos.files.desktop
  org.spinelos.Store.desktop
  org.spinelos.Games.desktop
  org.spinelos.WindowsApps.desktop
  org.spinelos.WineOpen.desktop
)

SPINEL_ICON_SVGS=(
  spinel-files.svg
  org.spinelos.Store.svg
  org.spinelos.Games.svg
  org.spinelos.WindowsApps.svg
)

SPINEL_REQUIRED_IME_PKGS=(
  fcitx5
  fcitx5-rime
  fcitx5-gtk
)
